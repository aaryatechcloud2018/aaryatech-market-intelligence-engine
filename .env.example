# Aaryatech Market Intelligence Engine - environment configuration
# Copy this file to ".env" and fill in values as needed.
# The core pipeline (ingestion, extraction, normalization, database
# loading, analytics) works WITHOUT any API key. These are only used
# for optional advanced semantic extraction / interpretation features.

# Optional: used only if you enable LLM-assisted extraction/summarization
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: override the default SQLite database location
# Default: database/market_intelligence.db
DATABASE_PATH=

# Optional: logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# --- Stage 2: audience data collection (src/audience_collection/) ---

# REQUIRED for Reddit collection. Reddit's public unauthenticated endpoints
# now return 403 Blocked, so OAuth is the only supported method.
# Get these for free at https://www.reddit.com/prefs/apps :
#   1. Log in to Reddit, go to the URL above, click "create another app...".
#   2. Name it anything (e.g. "aaryatech-research"). Select type "script".
#   3. "redirect uri" can be anything valid, e.g. http://localhost:8080
#   4. Click "create app". You'll see:
#      - REDDIT_CLIENT_ID  = the string under the app name (looks like a
#        random ~14-character code, NOT labeled "client id" on the page)
#      - REDDIT_CLIENT_SECRET = the string labeled "secret"
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Optional: only needed if you want the official YouTube Data API v3 path
# instead of the no-key comment-scraping fallback.
YOUTUBE_API_KEY=
